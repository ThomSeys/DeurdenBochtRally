{
  "buildCommand": "npm install && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "build/client",
  "rewrites": [
    {
      "source": "/build/:path*",
      "destination": "/build/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/index"
    }
  ]
}