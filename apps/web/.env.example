# Environment variables for the web app

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Resend Email (uses free test domain onboarding@resend.dev - no verification needed!)
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Optional: Custom domain email for production (defaults to onboarding@resend.dev in dev)
EMAIL_FROM=Deur Den Bocht <noreply@deurdenbocht.be>

# App
NODE_ENV=development
SESSION_SECRET=your_session_secret_here
APP_URL=http://localhost:5173
EVENT_DATE=2026-05-16

# Sanity CMS (optional - falls back to static content)
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
# Get these from sanity.io/manage after creating your project
