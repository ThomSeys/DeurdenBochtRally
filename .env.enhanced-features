# Add these to your .env file for enhanced features

# Email Notifications (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@deurdenbocht.be

# Push Notifications
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:info@deurdenbocht.be

# Public URL (used in emails and certificates)
PUBLIC_URL=https://deurdenbocht.be

# Event Date (for access control)
EVENT_DATE=2026-05-16
